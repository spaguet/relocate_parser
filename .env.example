# Application
APP_ENV=development
APP_NAME=relocate_helper
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=dev-only-fake-secret-not-for-production

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://relocate:relocate@postgres:5432/relocate_helper

# Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (MinIO in docker-compose)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=relocate-helper
S3_REGION=us-east-1
S3_USE_SSL=false

# Task queue
RQ_DEFAULT_QUEUE=default

# Embeddings (dimension must match migration / pgvector column)
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_NAME=voyage-3

# Object storage limits
STORAGE_KEY_PREFIX=raw
MAX_UPLOAD_BYTES=52428800
S3_SERVER_SIDE_ENCRYPTION=true
ALLOWED_MIME_TYPES=text/plain,text/markdown,text/csv,application/json,application/pdf,application/zip,application/gzip,image/jpeg,image/png,image/webp,image/gif,audio/mpeg,video/mp4,video/webm

# Future integrations — placeholders only, do not put real values here
TELEGRAM_BOT_TOKEN=fake-bot-token-replace-me
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=fake_api_hash_replace_me
TELETHON_SESSION_PATH=/run/secrets/telethon.session
TELEGRAM_SYNC_PAGE_SIZE=100
TELEGRAM_EDIT_CHECK_WINDOW=100
TELEGRAM_FLOOD_WAIT_MAX_SECONDS=3600
LLM_API_KEY=fake-llm-key-replace-me
LLM_PROVIDER=anthropic
EMBEDDINGS_API_KEY=fake-embeddings-key-replace-me
